import { Button, VerticalBox, LineEdit } from "std-widgets.slint";

// Struktur für die Log-Einträge
export struct LogEntry {
    timestamp: string,
    actor: string,
    pattern: string,
    mitigation: string,
    level: string,
    details: string,
}

export component AppWindow inherits Window {
    title: "AETHER SHIELD IV DEPLOYMENT CORE v1.0";
    width: 1200px;
    height: 700px;
    background: #020406;

    // Properties für die Kommunikation mit Rust
    in-out property <[LogEntry]> logs: [];
    in-out property <string> total_blocks: "1416";
    in-out property <string> total_isolation: "14";
    in-out property <string> system_integrity: "100%";
    in-out property <string> latency: "0.05ms";

    // Splashscreen Properties
    in-out property <bool> show_splash: true;
    in-out property <string> splash_status: "INITIALISING NEURAL LINK...";
    in-out property <float> splash_progress: 0.0;

    // Callbacks für Aktionen
    callback execute_immediate_action(string, string);
    callback trigger_simulation();

    // =========================================================================
    // MAIN CONTENT (DASHBOARD)
    // =========================================================================
    if (!show_splash) : VerticalBox {
        padding: 20px;
        spacing: 15px;

        // TOP HEADER
        HorizontalLayout {
            Text {
                text: "AETHER SHIELD SYSTEM";
                font-size: 24px;
                font-weight: 900;
                color: #FF4500;
            }
            Rectangle { } // Spacer
            Text {
                text: "● MATRIX CORES RUNNING";
                color: #00FF00;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        // STATS COUNTER GRID
        HorizontalLayout {
            spacing: 15px;
            height: 100px;

            // Stat Box 1
            Rectangle {
                background: #080c10;
                border-width: 1px;
                border-color: #141f2c;
                VerticalBox {
                    padding: 10px;
                    Text { text: "KI-FUZZING BLOCKS"; font-size: 10px; color: #506070; }
                    Text { text: root.total_blocks; font-size: 28px; font-weight: 700; color: #fff; }
                }
            }
            // Stat Box 2
            Rectangle {
                background: #080c10;
                border-width: 1px;
                border-color: #141f2c;
                VerticalBox {
                    padding: 10px;
                    Text { text: "TARPIN ISOLATIONEN"; font-size: 10px; color: #506070; }
                    Text { text: root.total_isolation; font-size: 28px; font-weight: 700; color: #fff; }
                }
            }
            // Stat Box 3
            Rectangle {
                background: #080c10;
                border-width: 1px;
                border-color: #141f2c;
                VerticalBox {
                    padding: 10px;
                    Text { text: "SYSTEM INTEGRITÄT"; font-size: 10px; color: #506070; }
                    Text { text: root.system_integrity; font-size: 28px; font-weight: 700; color: #00FF00; }
                }
            }
            // Stat Box 4
            Rectangle {
                background: #080c10;
                border-width: 1px;
                border-color: #141f2c;
                VerticalBox {
                    padding: 10px;
                    Text { text: "Ø ANALYSE-LATENZ"; font-size: 10px; color: #506070; }
                    Text { text: root.latency; font-size: 28px; font-weight: 700; color: #00bfff; }
                }
            }
        }

        // MIDDLE WORKSPACE (LOGS & DOSSIER)
        HorizontalLayout {
            spacing: 15px;

            // LOG-TABLE
            Rectangle {
                background: #04080c;
                border-width: 1px;
                border-color: #101a24;
                width: 60%;

                VerticalBox {
                    padding: 15px;
                    Text { text: "> NET-TRAFFIC INTERCEPTOR / REALTIME DECISION LOG"; color: #00bfff; font-weight: 700; }

                    VerticalBox {
                        spacing: 5px;
                        for entry[index] in root.logs : Rectangle {
                            height: 40px;
                            background: entry.level == "MYTHOS_CRIT" ? #300000 : #081018;
                            HorizontalLayout {
                                padding: 5px;
                                Text { text: entry.timestamp; color: #607080; width: 70px; vertical-alignment: center; }
                                Text { text: entry.actor; color: #fff; width: 150px; font-weight: 700; vertical-alignment: center; }
                                Text { text: entry.pattern; color: #ff8c00; width: 200px; vertical-alignment: center; }
                                Text { text: entry.level; color: entry.level == "OK" ? #00FF00 : #FF0000; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            // DOSSIER
            Rectangle {
                background: #04080c;
                border-width: 1px;
                border-color: #101a24;

                VerticalBox {
                    padding: 15px;
                    Text { text: "> SECURITY INCIDENT DOSSIER"; color: #607080; font-weight: 700; }
                    Rectangle { } // Spacer
                    Text { text: "[ KEIN ENTRAPMENT GEWÄHLT ]"; color: #405060; horizontal-alignment: center; }
                    Text { text: "Klicke auf einen Warn- oder kritischen Eintrag im Log, um tiefergehende Analysen zu laden."; color: #405060; font-size: 11px; horizontal-alignment: center; }
                    Rectangle { } // Spacer
                }
            }
        }

        // BOTTOM ACTION BUTTON
        Button {
            text: "[ INJECT KI-ATTACK SIMULATION (MYTHOS TYPE) ]";
            height: 45px;
            clicked => { root.trigger_simulation(); }
        }
    }

    // =========================================================================
    // ANIMIERTER SPLASH SCREEN OVERLAY
    // =========================================================================
    if (show_splash) : Rectangle {
        background: #010204;
        width: 100%;
        height: 100%;

        VerticalBox {
            alignment: center;
            spacing: 30px;

            // Das übergebene Bild zentriert anzeigen
            Image {
                source: @image-url("splash.png");
                width: 800px;
                height: 320px;
                image-fit: contain;
            }

            // Status-Meldung
            Text {
                text: root.splash_status;
                color: #ff8c00;
                font-family: "Monospace";
                font-size: 14px;
                horizontal-alignment: center;
                font-weight: 700;
            }

            // Der äußere Container der Progressbar zur horizontalen Zentrierung
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 400px;
                    height: 6px;
                    background: #101520;
                    border-radius: 3px;

                    // Der ladende Fortschrittsbalken mit absolut sicherer Vollfarbe
                    Rectangle {
                        x: 0;
                        width: parent.width * root.splash_progress;
                        height: 100%;
                        background: #00bfff; // Sauberes Flat-Cyan ohne Parser-Struggle
                        border-radius: 3px;

                        // Slint-Animation für flüssiges Laden
                        animate width {
                            duration: 150ms;
                            easing: ease-in-out;
                        }
                    }
                }
            }

            Text {
                text: "AETHER OS // KERNEL DESKTOP SHIELD SYSTEM v1.1.0";
                color: #304050;
                font-size: 10px;
                horizontal-alignment: center;
                font-family: "Monospace";
            }
        }
    }
}